{
  "name": "hearth",
  "productName": "Hearth",
  "version": "0.1.20",
  "description": "Touchscreen smart-home assistant powered by Claude Fable 5 — voice, Spotify, calendar, Home Assistant, weather, and ambient screensavers.",
  "author": "Ben Porter <ben@cre8ive.biz>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && electron-vite dev",
    "start": "electron-vite preview",
    "build": "node scripts/copy-ort.mjs && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --dir",
    "release": "npm run dist:win && node scripts/publish-release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": ">=0.57.0 <1.0.0",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-updater": "^6.8.9",
    "electron-vite": "^3.0.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "zustand": "^5.0.0"
  }
}
